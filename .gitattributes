# Binary data files — Git must never touch line endings.
# The B+ Tree index stores byte offsets into these files;
# any LF→CRLF conversion shifts every offset and corrupts the index.
data/*.txt          binary

# Serialized B+ Tree index files — raw binary, never convert.
*.dat               binary

# Source and config files — normalize to LF everywhere.
*.cpp               text eol=lf
*.h                 text eol=lf
*.md                text eol=lf
CMakeLists.txt      text eol=lf
.gitignore          text eol=lf